# .env.example

# PostgreSQL configuration
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=bike_gps_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Test database (PostgreSQL/PostGIS required for integration tests)
# DO NOT use the production DATABASE_URL for testing
# Use a separate test database with PostGIS enabled
TEST_DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/test_bike_gps

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET_KEY=your_jwt_secret
DEVICE_SECRET_KEY=your_device_secret
